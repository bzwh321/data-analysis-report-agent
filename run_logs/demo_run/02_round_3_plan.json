{
  "round": 3,
  "analytical_step": "attribution",
  "question": "家具类利润率-3.89pp是均匀分布在全年，还是集中于特定月份？是否为单次促销事件驱动？",
  "query_spec": {
    "metrics": [
      "profit_rate"
    ],
    "group_by": [
      "category",
      "month"
    ],
    "filters": {
      "category": "家具"
    },
    "date_range": {
      "start": "2024-01",
      "end": "2024-12"
    }
  },
  "expected_output": {
    "format": "table",
    "required_fields": [
      "month",
      "profit_rate_2024",
      "profit_rate_2023",
      "pp_change"
    ],
    "unit_sales": "万元",
    "unit_rate": "百分比"
  },
  "acceptance_criteria": {
    "min_rows": 12,
    "profit_rate_range": [
      0,
      100
    ],
    "all_required_fields": true
  },
  "stop_condition": {
    "if_impact_below_pct": 3,
    "reason": "如月度集中度<3%则判定为均匀分布"
  }
}